# ============================================================
# 地图相册平台 - 静态前端容器镜像（9 个 HTML + api.js + lib/，nginx 托管）
#
# 构建命令（在项目根目录执行）：
#   docker build -f Dockerfile.static -t <镜像仓库>/memomap-frontend:1.0 .
#
# 说明：
#   - 页面之间互相跳转均为相对路径，nginx 默认配置即可
#   - 本地引用的脚本：api.js + lib/（leaflet/dexie 已本地化，见 memo-home.html 等
#     页面的 src="lib/..." 引用；必须随镜像打包，否则线上 404 导致页面脚本中断）
#   - server.py 是本地开发用的 Python 静态服务器，nginx 场景不需要，不打包
#   - api.js 默认后端地址 http://localhost:3000/api/v1 由 nginx sub_filter
#     改写成同源 /api/v1，再由 nginx 反向代理到后端应用（详见 nginx.conf），
#     浏览器零跨域、零源码改动
# ============================================================
FROM nginx:1.27-alpine

# 9 个页面 + admin.html（管理端）+ api.js（根目录下）
# 注意：online_check.html 是旧副本页（.gitignore 标注不入库），勿加 COPY（加了会因文件不在仓库导致 ACR 构建失败）
# 注意：phone-link-prototype.html 已下线（2026-08-18 清理，功能已并入 connect-prototype.html），勿恢复 COPY
# [2026-09-02 冻结] 互联模块移出本版（备份库：互联备份库-20260902）：camera-prototype/connect-prototype/camera-ptp/usb-transport/browser-usb-transport/bridge-transport 的 COPY 一并移除
COPY album-prototype.html \
     login-prototype.html memo-home.html message-prototype.html \
     photographer-payment.html profile-prototype.html register-prototype.html \
     admin.html \
     /usr/share/nginx/html/

COPY api.js /usr/share/nginx/html/



# 卡片插画底图（他人主页/我的主页 hero 引用 card-bg.jpg，1ae52a5 起）——缺失时线上 404、卡片只剩染色层
COPY card-bg.jpg /usr/share/nginx/html/

# 本地化依赖库（leaflet/dexie/images）——页面按 lib/ 相对路径引用，缺失会 404
COPY lib /usr/share/nginx/html/lib/

# 本地化字体（行书 XuanZongTi 玄宗体 OFL 子集+woff2 全量兜底）——品牌字引用 fonts/，缺失会回退系统字体
COPY fonts /usr/share/nginx/html/fonts/

# PWA 手机网站（manifest + 应用图标）
COPY manifest.json icon-192.png icon-512.png /usr/share/nginx/html/

# 反向代理与 baseUrl 改写配置（覆盖镜像自带的 default.conf）
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# 健康检查：首页返回 200 即视为存活
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
