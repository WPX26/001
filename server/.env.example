# =============================================
# 地图相册平台 后端环境变量模板
# 复制为 .env 后填写实际值（.env 不入 git）
# =============================================

# ---------- 基础 ----------
# 运行环境：development / production
NODE_ENV=development
# 服务端口
PORT=3000

# ---------- 数据库 ----------
# MongoDB 连接串（本地默认；云数据库填云连接串）
MONGODB_URI=mongodb://127.0.0.1:27017/memomap

# ---------- JWT 认证 ----------
# 令牌签名密钥（务必使用强随机串，生产环境必须更换）
JWT_SECRET=change-me-to-a-long-random-string
# access token 有效期（秒，接口返回的 expiresIn 即此值，默认 1 天）
JWT_ACCESS_EXPIRES=86400
# refresh token 有效期（秒，默认 30 天）
JWT_REFRESH_EXPIRES=2592000

# ---------- 短信验证码（阿里云短信）----------
# 短信验证码有效期（秒）
SMS_CODE_EXPIRE_SECONDS=300
# 同一手机号同一场景发送最小间隔（秒，防刷）
SMS_SEND_INTERVAL_SECONDS=60
# 阿里云 AccessKey（RAM 用户，需 SMS 发送权限；未配置时 send-code 返回明确错误）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 短信签名（需在阿里云短信控制台申请并审核通过）
ALIYUN_SMS_SIGN_NAME=
# 验证码模板 CODE（如 SMS_123456789，模板变量为 ${code}）
ALIYUN_SMS_TEMPLATE_CODE=

# ---------- 对象存储（OSS 直传 + STS 临时凭证）----------
# 存储模式：local（本地磁盘，开发用）/ oss（阿里云 OSS，生产用）
STORAGE_MODE=local
# 本地模式：上传文件对外访问的基础地址
LOCAL_BASE_URL=http://localhost:3000
# 阿里云 OSS Bucket 所在区域（如 oss-cn-hangzhou）
OSS_REGION=
# OSS Bucket 名称
OSS_BUCKET=
# STS 扮演的 RAM 角色 ARN（需配置信任策略，允许当前 AccessKey 扮演）
OSS_ROLE_ARN=
# STS 角色会话名（自定义，如 memomap-upload）
OSS_ROLE_SESSION_NAME=memomap-upload
# 上传 AccessKey（RAM 用户，需 OSS 写 + STS AssumeRole 权限）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- 地图搜索（天地图地理编码）----------
# 天地图 Key：https://console.tianditu.gov.cn/ 创建"浏览器端"应用时勾选"地名搜索"服务后获取
# 用于 /map/search（正向编码）与 /map/reverse（逆编码）；未配置时这两个接口降级返回空结果
TDT_KEY=
