/**
 * index.uts —— ftp-receiver 插件 API 契约（平台无关层）
 *
 * 设计文档：《阶段②_UTS插件设计文档.md》v1.0 第 3 章（冻结）
 *
 * 本文件只定义类型、错误码常量与函数签名契约（JSDoc 为契约正文）；
 * 函数实现在各平台目录（app-android/index.uts、app-ios/index.uts 占位）。
 * 业务层引用方式（文档 2.2）：
 *   import { startServer, stopServer, onEvent } from '@/uni_modules/ftp-receiver/utssdk/interface/index.uts'
 */

// ================= 类型定义（文档 3.1） =================
//
// UTS 约束（UTS110111163）：对象字面量的目标类型必须是"构造类型"（class），
// 不支持 interface，故所有数据模型定义为 class（Kotlin data class 语义）。

/**
 * 启动参数
 */
export class FtpServerOptions {
  /** 监听端口。默认 21（相机 FTP 默认端口）。范围 1–65535（H3 修订）；
   *  个别 ROM 对 <1024 端口可能返回 EACCES，走错误码 1000，换端口重试。 */
  port: number = 0
  /** 存储目录：相对路径基于应用私有目录 filesDir（如 "ftp/photos"）；
   *  绝对路径必须落在应用私有目录内，否则校验失败（错误码 1003）。 */
  dir: string = ''
  /** FTP 用户名。非空，长度 ≤ 32 */
  user: string = ''
  /** FTP 密码。非空，长度 ≤ 32 */
  pass: string = ''
  constructor(port: number, dir: string, user: string, pass: string) {
    this.port = port
    this.dir = dir
    this.user = user
    this.pass = pass
  }
}

/**
 * 文件接收完成元数据（fileReceived 事件携带）
 */
export class FtpFileMeta {
  /** 文件绝对路径（filesDir 下的实际落盘位置） */
  path: string = ''
  /** 最终文件名（含扩展名；若发生命名冲突，为冲突处理后的实际文件名） */
  name: string = ''
  /** 文件字节数（与相机原文件一致） */
  size: number = 0
  constructor(path: string, name: string, size: number) {
    this.path = path
    this.name = name
    this.size = size
  }
}

/**
 * 事件联合类型分支（UTS 不支持对象字面量类型，逐分支具名 class）
 */
export class FtpConnectedEvent {
  type: string = 'connected'
  client: string = ''
  constructor(client: string) {
    this.client = client
  }
}
export class FtpTransferringEvent {
  type: string = 'transferring'
  name: string = ''
  size: number = 0
  constructor(name: string, size: number) {
    this.name = name
    this.size = size
  }
}
export class FtpFileReceivedEvent {
  type: string = 'fileReceived'
  meta: FtpFileMeta = new FtpFileMeta('', '', 0)
  constructor(meta: FtpFileMeta) {
    this.meta = meta
  }
}
export class FtpDisconnectedEvent {
  type: string = 'disconnected'
  client: string = ''
  constructor(client: string) {
    this.client = client
  }
}
export class FtpErrorEvent {
  type: string = 'error'
  code: number = 0
  message: string = ''
  constructor(code: number, message: string) {
    this.code = code
    this.message = message
  }
}

/**
 * 事件联合类型（与 H5 原型事件结构对齐）
 */
export type FtpServerEvent =
  | FtpConnectedEvent
  | FtpTransferringEvent
  | FtpFileReceivedEvent
  | FtpDisconnectedEvent
  | FtpErrorEvent

/** 事件回调签名 */
export type FtpEventCallback = (event: FtpServerEvent) => void

/** startServer 成功结果 */
export class FtpStartResult {
  /** 本机 IP（热点 AP 网卡枚举结果，供界面展示连接信息；无热点 IP 时为空串，L6） */
  ip: string = ''
  /** 实际监听端口 */
  port: number = 0
  constructor(ip: string, port: number) {
    this.ip = ip
    this.port = port
  }
}

// ================= 错误码常量（文档 3.3） =================

/** 端口被占用（ServerSocket 绑定失败，含 <1024 个别 ROM 的 EACCES） */
export const ERR_PORT_IN_USE = 1000
/** 前台服务权限缺失（未声明 FGS / DATA_SYNC 类型）或系统拒绝 */
export const ERR_PERMISSION_DENIED = 1001
/** stopServer() 时服务未运行 */
export const ERR_NOT_RUNNING = 1002
/** 参数非法：端口越界（非 1–65535 整数）/ 账号密码为空或超长 / dir 越界（含 ../ 穿越） */
export const ERR_INVALID_OPTIONS = 1003
/** 服务运行中重复 startServer() */
export const ERR_ALREADY_RUNNING = 1004
/** 存储目录创建失败（启动期 reject）/ 运行期写盘失败（error 事件异步上报，M4） */
export const ERR_DIR_UNAVAILABLE = 1005
/** 其他启动失败（如平台不支持 dataSync FGS）；无热点 IP 时的警告事件（L6） */
export const ERR_START_FAILED = 1006
/** Android 15 dataSync 前台服务超时上限触发（onTimeout，24h 累计，M6） */
export const ERR_FGS_TIMEOUT = 1007
/** 数据连接建立 / 传输失败（不终止服务，仅发 error 事件） */
export const ERR_DATA_CHANNEL = 1008

// ================= 函数契约（实现在平台目录，编译时按平台合并导出） =================
//
// UTS 插件接口文件约定：本文件只定义类型与常量；函数实现在
// utssdk/app-android/index.uts（Android）与 utssdk/app-ios/index.uts（占位）。
// 业务层 `import { startServer, stopServer, onEvent } from '…/interface/index.uts'` 时，
// 编译器按运行平台自动匹配实现（设计文档 2.2 / 5.5）。以下为三个函数的完整契约：

/**
 * 启动 FTP 接收服务（前台服务）。
 * 签名：startServer(options: FtpServerOptions): Promise<FtpStartResult>
 *
 * 语义：
 * - 同步检查参数合法性（非法立即 reject，错误码 1003）；异步执行启动。
 * - resolve 时保证：端口已绑定、监听已开始、前台服务通知已挂起 —— 之后即可接收连接。
 * - 重复调用返回 reject（错误码 1004），需先 stopServer()。
 *
 * 失败错误码：1000（端口占用）/ 1001（前台服务权限缺失或被系统拒绝）/
 *             1003（参数非法）/ 1005（目录不可写）/ 1006（其他启动失败）
 * @param options 启动参数（见 FtpServerOptions）
 * @returns Promise<FtpStartResult> 成功返回本机 IP 与端口（无热点 IP 时 ip 为空串，L6）
 */

/**
 * 停止 FTP 接收服务。
 * 签名：stopServer(): Promise<void>
 *
 * 语义：
 * - 关闭监听与所有活跃连接（传输中先终止数据通道，.part 由状态机清理，M10）、
 *   移除前台服务通知、释放 WAKE_LOCK、清除持久化配置（M2，防 START_STICKY 停了又起）。
 * - resolve 时保证服务已完全停止。
 * - 服务未运行时调用返回 reject（错误码 1002）。
 */

/**
 * 订阅服务事件。可多次调用，多个回调并存。
 * 签名：onEvent(handler: FtpEventCallback): () => void
 *
 * @param handler 事件回调（见 FtpServerEvent）
 * @returns 退订函数；调用后不再收到事件。页面 onUnmounted 时必须退订。
 */
