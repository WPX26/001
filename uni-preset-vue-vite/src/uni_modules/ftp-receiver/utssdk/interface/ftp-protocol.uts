/**
 * ftp-protocol.uts —— FTP 协议状态机（平台无关纯函数层）
 *
 * 设计文档：《阶段②_UTS插件设计文档.md》v1.0（冻结，含架构评审修订 H1–H3 / M1–M10 / L1–L7）
 *
 * 设计原则（文档 4.1）：
 *  - 本文件不接触任何网络 IO / 文件 IO / Android API。
 *  - 输入 = 当前状态 + 指令/内部事件；输出 = 新状态 + 响应列表 + IO 副作用列表。
 *  - IO 副作用由 Android 层（FtpServer.kt / FtpDataChannel.kt / FtpStore.kt）逐条执行，
 *    执行结果以内部事件（FtpInternalEvent）形式回注本状态机。
 *  - ②b 阶段 iOS 移植时本文件原样复用，仅重写副作用执行器。
 *
 * 两阶段协议（H2）：PASV/PORT 命令步只产 effect、不产最终响应；
 * 最终响应（227/200/425）由执行器回注内部事件后生成。
 *
 * 与文档的差异（实现细化，均已列入 v1.0 修订记录）：
 *  1) PASS 校验需要凭据与对端 IP，提供 createFtpMachine(config) 工厂；
 *     step/notify 等价方法为 handleCommand/handleEvent。
 *  2) FtpInternalEvent 补 dataListening/dataConnectFailed/dataTimeout/transferFailed（H2/M1）。
 *  3) TRANSFER.file 增加可选 temp 字段，供失败路径 discardTemp 引用。
 *
 * 单测：docs 阶段② 第 7 章 33 条用例，见 state-machine-test/（临时，验证后删除）。
 */

import { FtpFileMeta } from './index.uts'

// ================= 类型定义（文档 4.2） =================
//
// UTS 约束（UTS110111163）：对象字面量目标类型必须是"构造类型"（class），
// 故全部数据模型定义为 class；可选字段以 nullable + 默认 null 表达。

/** 会话状态：等待 USER（连接建立后初始态） */
export class FtpStateWaitingUser {
  kind: string = 'WAIT_USER'
  constructor() {
  }
}

/** 会话状态：等待 PASS（记录 user） */
export class FtpStateWaitingPass {
  kind: string = 'WAIT_PASS'
  constructor() {
  }
}

/** 会话状态：已登录，空闲 */
export class FtpStateLoggedIn {
  kind: string = 'LOGGED_IN'
  user: string = ''
  constructor(user: string) {
    this.user = user
  }
}

/** PORT 目标（host=控制连接对端 IP，H1） */
export class FtpPortTarget {
  host: string = ''
  port: number = 0
  constructor(host: string, port: number) {
    this.host = host
    this.port = port
  }
}

/** STOR 进行中的文件 */
export class FtpTransferFile {
  raw: string = ''
  resolved: string = ''
  size: number = 0
  temp: string | null = null
  constructor(raw: string, resolved: string, size: number, temp: string | null = null) {
    this.raw = raw
    this.resolved = resolved
    this.size = size
    this.temp = temp
  }
}

/** 会话状态：传输中（PASV 监听中 / PORT 连接中 / 已就绪） */
export class FtpStateTransfer {
  kind: string = 'TRANSFER'
  user: string = ''
  dataChannel: string = 'LISTENING'
  target: FtpPortTarget | null = null
  file: FtpTransferFile | null = null
  constructor(user: string, dataChannel: string, target: FtpPortTarget | null = null, file: FtpTransferFile | null = null) {
    this.user = user
    this.dataChannel = dataChannel
    this.target = target
    this.file = file
  }
}

/** 会话状态：终态（QUIT/异常），会话即销毁 */
export class FtpStateClosed {
  kind: string = 'CLOSED'
  reason: string | null = null
  constructor(reason: string | null = null) {
    this.reason = reason
  }
}

/** 会话状态 */
export type FtpState =
  | FtpStateWaitingUser
  | FtpStateWaitingPass
  | FtpStateLoggedIn
  | FtpStateTransfer
  | FtpStateClosed

/** 输入：控制连接收到的指令（已按 RFC 959 解析） */
export class FtpCommand {
  verb: string = ''
  args: string = ''
  constructor(verb: string, args: string) {
    this.verb = verb
    this.args = args
  }
}

// ---------- 输入：内部事件（由 Android 层执行副作用后回注；H2/M1 补齐成员） ----------

export class FtpEventDataListening {
  kind: string = 'dataListening'
  port: number = 0
  constructor(port: number) {
    this.port = port
  }
}
export class FtpEventDataAccepted {
  kind: string = 'dataAccepted'
  constructor() {
  }
}
export class FtpEventDataConnected {
  kind: string = 'dataConnected'
  constructor() {
  }
}
export class FtpEventDataConnectFailed {
  kind: string = 'dataConnectFailed'
  constructor() {
  }
}
export class FtpEventDataTimeout {
  kind: string = 'dataTimeout'
  constructor() {
  }
}
export class FtpEventDataComplete {
  kind: string = 'dataComplete'
  size: number = 0
  constructor(size: number) {
    this.size = size
  }
}
export class FtpEventTransferStalled {
  kind: string = 'transferStalled'
  constructor() {
  }
}
export class FtpEventTransferFailed {
  kind: string = 'transferFailed'
  constructor() {
  }
}
export class FtpEventCtrlIdleTimeout {
  kind: string = 'ctrlIdleTimeout'
  constructor() {
  }
}
export class FtpEventPeerClosed {
  kind: string = 'peerClosed'
  constructor() {
  }
}

/** 输入：内部事件（由 Android 层执行副作用后回注） */
export type FtpInternalEvent =
  | FtpEventDataListening
  | FtpEventDataAccepted
  | FtpEventDataConnected
  | FtpEventDataConnectFailed
  | FtpEventDataTimeout
  | FtpEventDataComplete
  | FtpEventTransferStalled
  | FtpEventTransferFailed
  | FtpEventCtrlIdleTimeout
  | FtpEventPeerClosed

// ---------- 输出：IO 副作用（Android 层逐条执行） ----------

export class FtpEffectOpenDataListen {
  kind: string = 'openDataListen'
  constructor() {
  }
}
export class FtpEffectConnectData {
  kind: string = 'connectData'
  host: string = ''
  port: number = 0
  constructor(host: string, port: number) {
    this.host = host
    this.port = port
  }
}
export class FtpEffectReceiveFile {
  kind: string = 'receiveFile'
  temp: string = ''
  target: string = ''
  expected: number = 0
  constructor(temp: string, target: string, expected: number) {
    this.temp = temp
    this.target = target
    this.expected = expected
  }
}
export class FtpEffectDiscardTemp {
  kind: string = 'discardTemp'
  temp: string = ''
  constructor(temp: string) {
    this.temp = temp
  }
}
export class FtpEffectCloseData {
  kind: string = 'closeData'
  constructor() {
  }
}
export class FtpEffectCloseControl {
  kind: string = 'closeControl'
  constructor() {
  }
}
export class FtpEffectEmitFileReceived {
  kind: string = 'emitFileReceived'
  meta: FtpFileMeta = new FtpFileMeta('', '', 0)
  constructor(meta: FtpFileMeta) {
    this.meta = meta
  }
}
export class FtpEffectEmitTransferring {
  kind: string = 'emitTransferring'
  name: string = ''
  size: number = 0
  constructor(name: string, size: number) {
    this.name = name
    this.size = size
  }
}
export class FtpEffectEmitError {
  kind: string = 'emitError'
  code: number = 0
  message: string = ''
  constructor(code: number, message: string) {
    this.code = code
    this.message = message
  }
}

/** 输出：IO 副作用（Android 层逐条执行） */
export type FtpEffect =
  | FtpEffectOpenDataListen
  | FtpEffectConnectData
  | FtpEffectReceiveFile
  | FtpEffectDiscardTemp
  | FtpEffectCloseData
  | FtpEffectCloseControl
  | FtpEffectEmitFileReceived
  | FtpEffectEmitTransferring
  | FtpEffectEmitError

/** step/notify 的输出 */
export class FtpStepResult {
  state: FtpState = new FtpStateWaitingUser()
  /** 需写给客户端的响应行（如 "331 ..."） */
  responses: string[] = []
  /** 待执行副作用（有序） */
  effects: FtpEffect[] = []
  /** true → 会话终结（Android 层随后关闭控制连接并清理） */
  fatal: boolean = false
  constructor(state: FtpState, responses: string[], effects: FtpEffect[], fatal: boolean) {
    this.state = state
    this.responses = responses
    this.effects = effects
    this.fatal = fatal
  }
}

/** 状态机工厂配置 */
export class FtpMachineConfig {
  user: string = ''
  pass: string = ''
  /** 热点枚举 IP，用于 227 的 IP 四段（文档 5.4） */
  ip: string = ''
  /** 控制连接对端 IP（相机实际 LAN 地址），PORT 模式 connectData 的 host（H1） */
  peerIp: string = ''
  /** 时间戳生成器（冲突命名后缀与 .part 临时名，默认 yyyyMMdd_HHmmss，可注入便于测试） */
  clock: (() => string) | null = null
  /** 目标文件名是否已存在（Android 层注入 FtpStore 查询；测试注入内存表） */
  exists: ((name: string) => boolean) | null = null
  constructor(user: string, pass: string, ip: string, peerIp: string, clock: (() => string) | null = null, exists: ((name: string) => boolean) | null = null) {
    this.user = user
    this.pass = pass
    this.ip = ip
    this.peerIp = peerIp
    this.clock = clock
    this.exists = exists
  }
}

/** parsePortArgs 返回值 */
export class FtpPortParseResult {
  port: number = 0
  rawIp: string = ''
  constructor(port: number, rawIp: string) {
    this.port = port
    this.rawIp = rawIp
  }
}

// ================= 纯函数（可独立单测） =================

/** 解析控制连接收到的一行指令（RFC 959：VERB [args]）。空行返回 null。 */
export function parseControlLine(line: string): FtpCommand | null {
  const t = line.trim()
  if (t.length == 0) return null
  const sp = t.indexOf(' ')
  if (sp < 0) return new FtpCommand(t.toUpperCase(), '')
  const verb = t.substring(0, sp).toUpperCase()
  const args = t.substring(sp + 1).trim()
  return new FtpCommand(verb, args)
}

/**
 * STOR 文件名白名单校验（文档 5.3 路径安全）：
 * 拒绝空名、/ 与 \、.. 穿越、首尾分隔符、控制字符。
 */
export function validateStorName(raw: string): boolean {
  if (raw.length == 0 || raw.length > 255) return false
  if (raw.startsWith('/') || raw.endsWith('/') || raw.startsWith('\\') || raw.endsWith('\\')) return false
  if (raw.indexOf('/') >= 0 || raw.indexOf('\\') >= 0) return false
  if (raw.indexOf('..') >= 0) return false
  if (raw == '.' || raw == '..') return false
  for (let i = 0; i < raw.length; i++) {
    const c = raw.charCodeAt(i)
    if (c != null && c < 32) return false            // 控制字符
  }
  return true
}

/**
 * 命名冲突规约（文档 5.3）：目标名已存在 → 追加时间戳后缀 <stem>_yyyyMMdd_HHmmss.<ext>。
 * @param exists 目标名是否已存在（由调用方注入）
 * @param ts     时间戳字符串（纯函数注入，可测）
 */
export function resolveTargetName(raw: string, exists: (name: string) => boolean, ts: string): string {
  if (!exists(raw)) return raw
  const dot = raw.lastIndexOf('.')
  if (dot > 0) {
    const stem = raw.substring(0, dot)
    const ext = raw.substring(dot + 1)
    return stem + '_' + ts + '.' + ext
  }
  return raw + '_' + ts
}

/** 构造 227 响应：IP 四段 + 端口高低字节（文档 4.4）。 */
export function buildPassiveReply(ip: string, port: number): string {
  const parts = ip.split('.')
  const h: number[] = [0, 0, 0, 0]
  for (let i = 0; i < 4 && i < parts.length; i++) {
    const n = parseInt(parts[i], 10)
    h[i] = isNaN(n) ? 0 : (n & 255)
  }
  return '227 Entering Passive Mode (' +
    h[0] + ',' + h[1] + ',' + h[2] + ',' + h[3] + ',' +
    (port >> 8) + ',' + (port & 255) + ')'
}

/**
 * 解析 PORT 参数 h1,h2,h3,h4,p1,p2（严格：6 段、每段 0-255、纯数字）。非法返回 null。
 * H1：仅返回端口；IP 段只作日志记录，不用于连接（host 一律取控制连接对端 IP）。
 */
export function parsePortArgs(args: string): FtpPortParseResult | null {
  const parts = args.split(',')
  if (parts.length != 6) return null
  const nums: number[] = []
  for (let i = 0; i < 6; i++) {
    const p = parts[i].trim()
    const n = parseInt(p, 10)
    if (isNaN(n) || n < 0 || n > 255 || n.toString() != p) return null
    nums.push(n)
  }
  const rawIp = nums[0] + '.' + nums[1] + '.' + nums[2] + '.' + nums[3]
  const port = nums[4] * 256 + nums[5]
  return new FtpPortParseResult(port, rawIp)
}

/** 默认时间戳格式 yyyyMMdd_HHmmss（本地时间）。 */
function defaultClock(): string {
  const d = new Date()
  const p = (n: number, w: number): string => {
    let s = n.toString()
    while (s.length < w) s = '0' + s
    return s
  }
  return p(d.getFullYear(), 4) + p(d.getMonth() + 1, 2) + p(d.getDate(), 2) + '_' +
    p(d.getHours(), 2) + p(d.getMinutes(), 2) + p(d.getSeconds(), 2)
}

/** .part 临时文件名（文档 5.3：.<name>.<ts>.part） */
function partName(target: string, ts: string): string {
  return '.' + target + '.' + ts + '.part'
}

/** 传输中失败的公共错误消息 */
const MSG_DATA_CHANNEL = '数据连接建立或传输失败，请检查相机 FTP 设置'

// ================= 状态机工厂（文档 4.2 的 step/notify 的实例化载体） =================

export function createFtpMachine(config: FtpMachineConfig): FtpMachine {
  return new FtpMachine(config)
}

export class FtpMachine {
  private _user: string
  private _pass: string
  private _ip: string
  private _peerIp: string
  private _clock: () => string
  private _exists: (name: string) => boolean
  private _state: FtpState
  private _pendingUser: string
  private _failCount: number

  constructor(config: FtpMachineConfig) {
    this._user = config.user
    this._pass = config.pass
    this._ip = config.ip
    this._peerIp = config.peerIp
    this._clock = config.clock != null ? config.clock : ((): string => defaultClock())
    this._exists = config.exists != null ? config.exists : (_name: string): boolean => false
    this._state = new FtpStateWaitingUser()
    this._pendingUser = ''
    this._failCount = 0
  }

  getState(): FtpState {
    return this._state
  }

  /** 控制连接收到一行指令（等价文档 step(state, cmd)，内部维护状态） */
  handleCommand(line: string): FtpStepResult {
    const cmd = parseControlLine(line)
    if (cmd == null) return this._out([])
    return this._dispatch(cmd)
  }

  /** 内部事件回注（等价文档 notify(state, ev)） */
  handleEvent(ev: FtpInternalEvent): FtpStepResult {
    return this._onEvent(ev)
  }

  // ---------- 内部 ----------

  private _out(responses: string[], effects: FtpEffect[] = [], fatal: boolean = false): FtpStepResult {
    return new FtpStepResult(this._state, responses, effects, fatal)
  }

  private _noop(): FtpStepResult {
    return this._out([])
  }

  private _dispatch(cmd: FtpCommand): FtpStepResult {
    const s = this._state
    if (s.kind == 'CLOSED') return this._out([], [], true)

    // USER/PASS 任何状态可受理（USER 重置登录序列）
    if (cmd.verb == 'USER') return this._onUser(cmd.args)
    if (cmd.verb == 'PASS') return this._onPass(cmd.args)

    // 未登录阶段非 USER/PASS 一律 530（文档 4.6）
    if (s.kind == 'WAIT_USER' || s.kind == 'WAIT_PASS') {
      return this._out(['530 Not logged in'])
    }

    switch (cmd.verb) {
      case 'PASV': return this._onPasv()
      case 'PORT': return this._onPort(cmd.args)
      case 'TYPE': return this._onType(cmd.args)
      case 'STOR': return this._onStor(cmd.args)
      case 'SYST': return this._out(['215 UNIX Type: L8'])
      case 'CWD': return this._out(['250 Directory changed'])          // M5 佳能目录类兼容
      case 'PWD': return this._out(['257 "/" is current directory'])   // M5
      case 'MKD': return this._out(['257 Directory created'])          // M5
      case 'NOOP': return this._out(['200 Command okay'])              // M5
      case 'LIST': return this._out(['502 Command not implemented'])   // L5：最小命令集，不做浏览
      case 'QUIT': return this._onQuit()
      default:
        return this._out(['500 Syntax error, command unrecognized'])
    }
  }

  private _onUser(user: string): FtpStepResult {
    if (user.length == 0) return this._out(['501 Syntax error in parameters'])
    // 仅记录用户名，不校验（防账号枚举，文档 4.6）
    this._pendingUser = user
    this._failCount = 0
    this._state = new FtpStateWaitingPass()
    return this._out(['331 User name okay, need password'])
  }

  private _onPass(pass: string): FtpStepResult {
    if (this._state.kind != 'WAIT_PASS') {
      return this._out(['530 Not logged in'])
    }
    if (pass == this._pass && this._pendingUser == this._user) {
      this._failCount = 0
      this._state = new FtpStateLoggedIn(this._user)
      return this._out(['230 User logged in, proceed'])
    }
    this._failCount += 1
    if (this._failCount >= 3) {
      // 连续 3 次失败 → 421 会话终结（文档 4.4）
      this._state = new FtpStateClosed('too many attempts')
      return this._out(['421 Too many attempts'], [], true)
    }
    return this._out(['530 Not logged in'])
  }

  /**
   * PASV（H2 两阶段）：命令步无响应，仅产出 openDataListen；
   * 执行器绑定随机端口后回注 dataListening(port)，此时生成 227。
   * L3：新 PASV 覆盖旧通道，先 closeData（幂等）。
   */
  private _onPasv(): FtpStepResult {
    this._state = new FtpStateTransfer(this._user, 'LISTENING')
    return this._out([], [new FtpEffectCloseData(), new FtpEffectOpenDataListen()])
  }

  /**
   * PORT（H2 两阶段 + H1 拓扑修正）：命令步无响应，仅产出 connectData；
   * host 一律取控制连接对端 IP（this._peerIp），PORT 参数仅取端口；
   * 执行器成功后回注 dataConnected → 200；失败回注 dataConnectFailed → 425。
   */
  private _onPort(args: string): FtpStepResult {
    const parsed = parsePortArgs(args)
    if (parsed == null) return this._out(['501 Syntax error in parameters'])
    this._state = new FtpStateTransfer(this._user, 'CONNECTING', new FtpPortTarget(this._peerIp, parsed.port))
    return this._out([], [new FtpEffectCloseData(), new FtpEffectConnectData(this._peerIp, parsed.port)])
  }

  private _onType(args: string): FtpStepResult {
    if (args.toUpperCase() == 'I') return this._out(['200 Command okay'])
    return this._out(['504 Command not implemented for that parameter'])
  }

  private _onStor(args: string): FtpStepResult {
    const s = this._state
    if (s.kind != 'TRANSFER' || s.dataChannel != 'CONNECTED') {
      return this._out(["425 Can't open data connection"])
    }
    if (!validateStorName(args)) {
      return this._out(['553 Requested action not taken: illegal file name'])
    }
    const ts = this._clock()
    const target = resolveTargetName(args, this._exists, ts)
    const temp = partName(target, ts)
    this._state = new FtpStateTransfer(this._user, 'CONNECTED', null, new FtpTransferFile(args, target, 0, temp))
    return this._out(
      ['150 File status okay; about to open data connection'],
      [new FtpEffectEmitTransferring(target, 0), new FtpEffectReceiveFile(temp, target, 0)]
    )
  }

  /**
   * QUIT（M10）：任意状态终结；传输中（TRANSFER/file）额外 discardTemp 清理 .part。
   */
  private _onQuit(): FtpStepResult {
    const s = this._state
    if (s.kind == 'TRANSFER' && s.file != null) {
      this._state = new FtpStateClosed('QUIT')
      return this._out(
        ['221 Service closing control connection'],
        [new FtpEffectDiscardTemp(s.file.temp ?? partName(s.file.resolved, '')), new FtpEffectCloseControl()],
        true
      )
    }
    this._state = new FtpStateClosed('QUIT')
    return this._out(['221 Service closing control connection'], [], true)
  }

  private _onEvent(ev: FtpInternalEvent): FtpStepResult {
    const s = this._state
    if (s.kind == 'CLOSED') return this._out([], [], true)

    switch (ev.kind) {
      case 'dataListening': {
        // H2：PASV 绑定成功 → 生成 227
        if (s.kind == 'TRANSFER' && s.dataChannel == 'LISTENING') {
          return this._out([buildPassiveReply(this._ip, ev.port)])
        }
        return this._noop()
      }
      case 'dataAccepted': {
        if (s.kind == 'TRANSFER' && s.dataChannel == 'LISTENING') {
          this._state = new FtpStateTransfer(s.user, 'CONNECTED')
          return this._noop()
        }
        return this._noop()
      }
      case 'dataConnected': {
        // H2：PORT 连接成功 → 生成 200
        if (s.kind == 'TRANSFER' && s.dataChannel == 'CONNECTING') {
          this._state = new FtpStateTransfer(s.user, 'CONNECTED')
          return this._out(['200 Command okay'])
        }
        return this._noop()
      }
      case 'dataConnectFailed': {
        // H2/H1：PORT 连接失败 → 425 + LOGGED_IN + error(1008)（M9）
        if (s.kind == 'TRANSFER' && s.dataChannel == 'CONNECTING') {
          this._state = new FtpStateLoggedIn(s.user)
          return this._out(
            ["425 Can't open data connection"],
            [new FtpEffectCloseData(), new FtpEffectEmitError(1008, MSG_DATA_CHANNEL)]
          )
        }
        return this._noop()
      }
      case 'dataTimeout': {
        if (s.kind == 'TRANSFER' && s.dataChannel == 'LISTENING') {
          // PASV 监听 30s 无连接 → 回 LOGGED_IN，不发 421（相机可重发 PASV，文档 4.7）
          this._state = new FtpStateLoggedIn(s.user)
          return this._out([], [new FtpEffectCloseData()])
        }
        if (s.kind == 'TRANSFER' && s.dataChannel == 'CONNECTED' && s.file == null) {
          // M1：数据连接就绪后 30s 无 STOR → 425 + closeData + LOGGED_IN
          this._state = new FtpStateLoggedIn(s.user)
          return this._out(["425 Can't open data connection"], [new FtpEffectCloseData()])
        }
        return this._noop()
      }
      case 'dataComplete': {
        if (s.kind == 'TRANSFER' && s.file != null) {
          const f: FtpTransferFile = s.file
          if (f.size > 0 && f.size != ev.size) {
            // 大小与相机声明不符 → 删除半成品 + error(1008)（L1：expected=0 时跳过校验，文档 4.4）
            this._state = new FtpStateLoggedIn(s.user)
            return this._out(
              ['426 Connection closed; transfer aborted'],
              [new FtpEffectDiscardTemp(f.temp ?? partName(f.resolved, '')), new FtpEffectCloseData(), new FtpEffectEmitError(1008, MSG_DATA_CHANNEL)]
            )
          }
          this._state = new FtpStateLoggedIn(s.user)
          return this._out(
            ['226 Closing data connection'],
            [new FtpEffectEmitFileReceived(new FtpFileMeta(f.resolved, f.resolved, ev.size)), new FtpEffectCloseData()]
          )
        }
        return this._noop()
      }
      case 'transferStalled': {
        if (s.kind == 'TRANSFER' && s.file != null) {
          this._state = new FtpStateLoggedIn(s.user)
          return this._out(
            ['426 Connection closed; transfer aborted'],
            [new FtpEffectDiscardTemp(s.file.temp ?? partName(s.file.resolved, '')), new FtpEffectCloseData(), new FtpEffectEmitError(1008, MSG_DATA_CHANNEL)]
          )
        }
        return this._noop()
      }
      case 'transferFailed': {
        // M4/M9：写盘失败（磁盘满等）→ 450 + 清半成品 + error(1005)（不终止服务）
        if (s.kind == 'TRANSFER' && s.file != null) {
          this._state = new FtpStateLoggedIn(s.user)
          return this._out(
            ['450 Requested file action not taken'],
            [new FtpEffectDiscardTemp(s.file.temp ?? partName(s.file.resolved, '')), new FtpEffectCloseData(), new FtpEffectEmitError(1005, '存储目录写入失败（磁盘空间不足或目录不可写）')]
          )
        }
        return this._noop()
      }
      case 'ctrlIdleTimeout': {
        if (s.kind == 'WAIT_USER' || s.kind == 'WAIT_PASS' || s.kind == 'LOGGED_IN') {
          this._state = new FtpStateClosed('ctrl idle timeout')
          return this._out(['421 Timeout'], [new FtpEffectCloseControl()], true)
        }
        // M1：TRANSFER 期间控制空闲超时挂起，由传输定时器接管
        return this._noop()
      }
      case 'peerClosed': {
        if (s.kind == 'TRANSFER' && s.file != null) {
          // M10：传输中对端异常关闭 → 清 .part + 终结 + error(1008)
          this._state = new FtpStateClosed('peer closed')
          return this._out(
            [],
            [new FtpEffectDiscardTemp(s.file.temp ?? partName(s.file.resolved, '')), new FtpEffectCloseControl(), new FtpEffectEmitError(1008, MSG_DATA_CHANNEL)],
            true
          )
        }
        this._state = new FtpStateClosed('peer closed')
        return this._out([], [new FtpEffectCloseControl()], true)
      }
      default:
        return this._noop()
    }
  }
}
